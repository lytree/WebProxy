{
  "name": "SmartProxy",
  "description": "SmartProxy is a browser extension that will automatically enable/disable proxy for the sites you visit, based on customizable patterns.",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/pako": "^3.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-webextension-mock": "^4.2.0",
    "@xhmikosr/decompress": "^11.1.4",
    "ts-jest": "^29.4.12",
    "tsc": "^2.0.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7.1.0",
    "web-ext-types": "^3.2.1"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint ./src",
    "build": "npm run build-ch",
    "build-ff": "cross-env EXTENSION=firefox node scripts/build.mjs",
    "build-ff:watch": "cross-env EXTENSION=firefox NODE_ENV=development node scripts/build.mjs --watch",
    "build-ff-unlisted": "cross-env EXTENSION=firefox-unlisted node scripts/build.mjs",
    "build-ff-android": "cross-env EXTENSION=firefox-android node scripts/build.mjs",
    "build-ch": "cross-env EXTENSION=chrome node scripts/build.mjs",
    "build-ch:watch": "cross-env EXTENSION=chrome NODE_ENV=development node scripts/build.mjs --watch",
    "build-ed": "cross-env EXTENSION=edge node scripts/build.mjs",
    "build-ed:watch": "cross-env EXTENSION=edge NODE_ENV=development node scripts/build.mjs --watch",
    "build-op": "cross-env EXTENSION=opera node scripts/build.mjs",
    "build-op:watch": "cross-env EXTENSION=opera NODE_ENV=development node scripts/build.mjs --watch",
    "build-th": "cross-env EXTENSION=thunderbird node scripts/build.mjs",
    "build-th:watch": "cross-env EXTENSION=thunderbird NODE_ENV=development node scripts/build.mjs --watch"
  },
  "jest": {
    "setupFiles": [
      "jest-webextension-mock"
    ],
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/src/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "license": "GPL-3.0",
  "dependencies": {
    "pako": "^3.0.2",
    "webdav": "^5.10.0"
  }
}
