{
  "name": "WebProxy",
  "version": "0.0.2",
  "description": "WebProxy is a browser extension that will automatically enable/disable proxy for the sites you visit, based on customizable patterns.",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pako": "^3.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@xhmikosr/decompress": "^11.1.4",
    "cross-env": "^7.0.3",
    "crx": "^5.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.13.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-webextension-mock": "^4.2.0",
    "jszip": "^3.10.2",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0",
    "web-ext": "^10.8.0",
    "web-ext-types": "^3.2.1"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src scripts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build-ch",
    "build-ff": "cross-env EXTENSION=firefox node scripts/build.mjs",
    "build-ff:watch": "cross-env EXTENSION=firefox NODE_ENV=development node scripts/build.mjs --watch",
    "build-ff-unlisted": "cross-env EXTENSION=firefox-unlisted node scripts/build.mjs",
    "build-ff-android": "cross-env EXTENSION=firefox-android node scripts/build.mjs",
    "build-ch": "cross-env EXTENSION=chrome node scripts/build.mjs",
    "build-ch:watch": "cross-env EXTENSION=chrome NODE_ENV=development node scripts/build.mjs --watch",
    "build-ed": "cross-env EXTENSION=edge node scripts/build.mjs",
    "build-ed:watch": "cross-env EXTENSION=edge NODE_ENV=development node scripts/build.mjs --watch",
    "build-op": "cross-env EXTENSION=opera node scripts/build.mjs",
    "build-op:watch": "cross-env EXTENSION=opera NODE_ENV=development node scripts/build.mjs --watch",
    "build-th": "cross-env EXTENSION=thunderbird node scripts/build.mjs",
    "build-th:watch": "cross-env EXTENSION=thunderbird NODE_ENV=development node scripts/build.mjs --watch",
    "dev": "pnpm run build-ch && run-p build-ch:watch start:chromium",
    "dev-firefox": "pnpm run build-ff && run-p build-ff:watch start:firefox",
    "start:chromium": "web-ext run --source-dir extension --target=chromium",
    "start:firefox": "web-ext run --source-dir extension --target=firefox-desktop",
    "pack": "pnpm run pack:zip && pnpm run pack:crx && pnpm run pack:xpi",
    "pack:zip": "node scripts/pack.mjs",
    "pack:crx": "crx pack extension -o extension.crx -p key.pem",
    "pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ web-ext build --source-dir extension --filename extension.xpi --overwrite-dest"
  },
  "jest": {
    "setupFiles": [
      "jest-webextension-mock"
    ],
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/src/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "license": "GPL-3.0",
  "dependencies": {
    "pako": "^3.0.2",
    "webdav": "^5.10.0"
  }
}
